{
  "name": "wewifi-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "npm run migrate:generate && npm run migrate:push && npm run seed && node dist/index.js",
    "migrate": "drizzle-kit migrate --config ./src/drizzle.config.ts",
    "migrate:generate": "drizzle-kit generate --config ./src/drizzle.config.ts",
    "migrate:push": "drizzle-kit push --config ./src/drizzle.config.ts",
    "seed": "tsx src/db/seed/seeder.ts",
    "samples:excel": "tsx src/db/scripts/generate-excel-samples.ts",
    "sms:test": "tsx src/db/scripts/test-sms-connection.ts"
  },
  "dependencies": {
    "tsx": "^4.22.3",
    "bcrypt": "^5.1.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-kit": "^0.31.10",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "html-to-text": "^10.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-openvpn": "^0.1.1",
    "node-routeros": "^1.6.8",
    "node-vpn-daemon": "^0.0.17",
    "node-vpn-manager": "^0.0.15",
    "nodemailer": "^8.0.10",
    "pg": "^8.11.0",
    "pug": "^3.0.4",
    "ssh2": "^1.17.0",
    "telnet-client": "^2.2.13",
    "tslib": "^2.8.1",
    "winston": "^3.9.0",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/hpp": "^0.2.7",
    "@types/html-to-text": "^9.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/pug": "^2.0.10",
    "@types/ssh2": "^1.15.5",
    "typescript": "^5.2.2"
  }
}
