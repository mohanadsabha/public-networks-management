# App runtime
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/public_networks

# Auth / JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_TTL=7d
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_WWW=http://localhost:5173

# Default seeded admin account
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=admin123

# Email / password reset
EMAIL=admin@wifi.we
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# TweetSMS (https://www.tweetsms.ps)
TWEETSMS_USER=
TWEETSMS_PASSWORD=
# Optional legacy fallback if password is not set
TWEETSMS_API_KEY=
SMS_SENDER=WeNet

# OpenVPN
VPN_ENABLED=false
OPENVPN_PATH=
OVPN_HOST=
OVPN_PORT=1194
OVPN_USER=
OVPN_PASS=

# MikroTik
MIKROTIK_HOST=
MIKROTIK_PORT=8729
MIKROTIK_SSH_PORT=22
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_USE_SSL=true

# Usage sync interval in minutes
syncTime=5
